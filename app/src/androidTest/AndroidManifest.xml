<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The same fixed-certificate test APK checks UI and in-place data upgrades. -->
    <instrumentation android:name="dev.ghost.nearbyim.SigningUpgradeInstrumentation" android:targetPackage="dev.ghost.nearbyim" />
    <application>
        <!-- Synthetic fixtures only; this provider is absent from every client APK. -->
        <provider android:name="dev.ghost.nearbyim.SourceTestProvider" android:authorities="dev.ghost.nearbyim.test.sources" android:exported="true" android:grantUriPermissions="true">
            <!-- This fixture requires an actual URI grant; the client never requests this signature permission. -->
            <path-permission android:path="/export/location" android:readPermission="android.permission.MANAGE_DOCUMENTS" />
        </provider>
        <provider android:name="dev.ghost.nearbyim.AvatarTestProvider" android:authorities="dev.ghost.nearbyim.test.avatars" android:exported="true" />
        <provider android:name="dev.ghost.nearbyim.DirectoryTestProvider" android:authorities="dev.ghost.nearbyim.test.directories" android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
    </application>
</manifest>

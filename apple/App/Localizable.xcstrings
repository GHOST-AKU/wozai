    "The latest 200 public messages are kept in this app session. Stopping reception preserves them until the app quits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest 200 public messages are kept in this app session. Stopping reception preserves them until the app quits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次运行最多保留最近 200 条公共消息。停止接收后仍可查看，退出应用后清空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次執行最多保留最近 200 則公開訊息。停止接收後仍可查看，結束應用程式後清空。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の起動中に直近200件の公開メッセージを保持します。受信を止めてもアプリ終了まで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 앱 세션에서 최근 공개 메시지 200개를 보관합니다. 수신을 중지해도 앱을 종료할 때까지 볼 수 있습니다."
          }
        }
      }
    },

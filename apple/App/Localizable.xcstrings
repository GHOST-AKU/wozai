    "Remembering a device is separate from comparing its safety code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembering a device is separate from comparing its safety code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住设备不代表已比对安全码核验身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記住裝置與比對安全碼是不同的操作。"

    },
    "Keep both apps open. Windows connects from its Bluetooth LE device list. New identities still require confirmation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep both apps open. Windows connects from its Bluetooth LE device list. New identities still require confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持两端应用打开。在 Windows 的低功耗蓝牙设备列表中连接。新设备身份仍需确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持兩端應用程式開啟。在 Windows 的低功耗藍牙裝置清單中連線。新裝置身分仍需確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のアプリを開いたまま、Windows の Bluetooth LE 一覧から接続します。新しい相手の確認は必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

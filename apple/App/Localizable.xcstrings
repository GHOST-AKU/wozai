          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在局域网中发现设备。重新打开应用时恢复接收。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

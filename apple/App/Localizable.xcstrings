    "Messages stay on this device. Transport encryption does not encrypt the local chat database.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages stay on this device. Transport encryption does not encrypt the local chat database."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息保存在本机。传输加密不等于本地聊天数据库已加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息儲存於本機，傳輸加密不會加密本機的對話資料庫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージはこのデバイスに保存されます。通信の暗号化は、ローカルの会話データベースを暗号化するものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지는 이 기기에 저장됩니다. 전송 암호화가 로컬 대화 데이터베이스를 암호화하는 것은 아닙니다."
          }
        }
      }
    },

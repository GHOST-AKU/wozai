    "Nearby devices can read messages sent here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby devices can read messages sent here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近设备可以阅读这里发出的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近裝置可以閱讀這裡送出的訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで送信したメッセージは近くの端末が読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처 기기에서 이곳에 보낸 메시지를 읽을 수 있습니다."
          }
        }
      }
    },
    "Nearby devices can read these messages. Reception resumes when you reopen the app. The latest 200 messages stay only until the app quits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby devices can read these messages. Reception resumes when you reopen the app. The latest 200 messages stay only until the app quits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近设备可以阅读这些消息。重新打开应用会恢复接收。最近 200 条消息只保留到应用退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近裝置可以閱讀這些訊息。重新開啟應用程式會恢復接收。最近 200 則訊息只保留到應用程式結束。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くの端末がメッセージを読めます。アプリを開き直すと受信を再開します。直近200件はアプリ終了まで保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처 기기에서 메시지를 읽을 수 있습니다. 앱을 다시 열면 수신이 재개됩니다. 최근 200개 메시지는 앱을 종료할 때까지 보관됩니다."
          }
        }
      }
    },

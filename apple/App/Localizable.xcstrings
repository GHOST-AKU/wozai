    "Looking for nearby devices…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for nearby devices…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找附近设备…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在尋找附近裝置…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くの端末を検索中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 기기 검색 중…"
          }
        }
      }
    },
    "Nearby devices and relays can read these messages. Public messages are not end-to-end encrypted. Reception resumes when you reopen the app. The latest 200 messages stay only until the app quits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby devices and relays can read these messages. Public messages are not end-to-end encrypted. Reception resumes when you reopen the app. The latest 200 messages stay only until the app quits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近设备和中继可读取消息。公开消息不使用端到端加密。重新打开应用会恢复接收，最近 200 条消息仅保留到退出应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近裝置和中繼可讀取訊息。公開訊息不使用端對端加密。重新開啟 App 會恢復接收，最近 200 則訊息僅保留到結束 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くの端末と中継端末は公開メッセージを読めます。エンドツーエンド暗号化はありません。アプリを開き直すと受信が再開され、直近の200件はアプリの終了まで保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 기기와 중계 기기가 메시지를 읽을 수 있습니다. 공개 메시지는 종단간 암호화되지 않습니다. 앱을 다시 열면 수신이 재개되며, 최근 200개 메시지는 앱 종료까지 보관됩니다."
          }
        }
      }
    },
    "Nearby devices and relays can read your messages. A device passing on a message does not confirm who received it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby devices and relays can read your messages. A device passing on a message does not confirm who received it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近设备和中继可读取你的消息。转交给附近设备后，仍无法确认最后谁收到了消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近裝置和中繼可讀取你的訊息。轉交給附近裝置後，仍無法確認最後誰收到訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くの端末と中継端末はメッセージを読めます。中継されても、誰に届いたかは確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 기기와 중계 기기가 메시지를 읽을 수 있습니다. 메시지가 중계되어도 최종 수신자를 확인할 수 없습니다."
          }
        }
      }
    },

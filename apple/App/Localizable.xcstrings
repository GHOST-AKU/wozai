    "A new device asks for permission before chatting. Use the safety code in the conversation to verify its identity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new device asks for permission before chatting. Use the safety code in the conversation to verify its identity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新设备发起私聊需要你同意。可在会话中使用安全码核验身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新裝置發起私聊需要你同意。可在對話中使用安全碼驗證身分。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい端末からのチャットには承認が必要です。会話の安全コードで相手を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기기와 채팅하려면 요청을 승인해야 합니다. 대화의 안전 코드로 상대를 확인할 수 있습니다."
          }
        }
      }
    },

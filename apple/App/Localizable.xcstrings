    "Camera unavailable. Read an exported QR image or compare the full code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera unavailable. Read an exported QR image or compare the full code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机不可用，请读取导出的二维码图片或比对完整安全码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機無法使用，請讀取匯出的 QR 圖片或比對完整安全碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを利用できません。書き出した QR 画像を読み込むか、コード全体を比較してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 사용할 수 없습니다. 내보낸 QR 이미지를 읽거나 전체 코드를 비교하세요."
          }
        }
      }
    },

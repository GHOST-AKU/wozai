    "Use the same local network, or keep Wi-Fi and Bluetooth enabled for nearby Apple peer-to-peer discovery. Only enable receiving when you want to be found.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same local network, or keep Wi-Fi and Bluetooth enabled for nearby Apple peer-to-peer discovery. Only enable receiving when you want to be found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接同一局域网，或保持 Wi-Fi 与蓝牙开启以发现附近 Apple 点对点设备。仅在希望被发现时开启接收。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接同一區域網路，或保持 Wi-Fi 與藍牙開啟以探索附近 Apple 點對點裝置。僅在希望被探索時開啟接收。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じLANに接続するか、Wi-FiとBluetoothを有効にして近くのApple端末を探索します。見つけてほしいときだけ受信を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 로컬 네트워크에 연결하거나 Wi-Fi와 Bluetooth를 켜서 근처 Apple 기기를 찾으세요. 검색을 허용할 때만 수신을 켜세요."
          }
        }
      }
    },
    "Read": {
      "localizations": {
        "en": {

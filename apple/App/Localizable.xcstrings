    "The connection will end. Chat history stays on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection will end. Chat history stays on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将断开当前连接，聊天记录仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線將會結束，對話記錄仍保留於本機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を終了します。会話履歴はこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 종료됩니다. 대화 기록은 이 기기에 유지됩니다."
          }
        }
      }
    },
    "The message could not be saved. No delivery receipt was sent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message could not be saved. No delivery receipt was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存消息，未发送送达回执。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存訊息，未傳送送達回執。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを保存できませんでした。配信確認は送信されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 저장할 수 없어 전달 확인을 보내지 않았습니다."
          }
        }
      }
    },
    "The peer sent an invalid or incompatible message.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The peer sent an invalid or incompatible message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方发送了无效或不兼容的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方傳送了無效或不相容的訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が無効または互換性のないメッセージを送信しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기가 잘못되었거나 호환되지 않는 메시지를 보냈습니다."
          }
        }
      }
    },
    "The scanned code does not match": {
      "localizations": {

        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを記憶することと、セーフティコードを比較することは別の操作です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 기억하는 것과 안전 코드를 비교하는 것은 별개의 작업입니다."

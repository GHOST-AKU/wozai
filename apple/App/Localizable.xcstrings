    "Relay passes public messages between nearby devices. It starts off every time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay passes public messages between nearby devices. It starts off every time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中继会在附近设备之间转发公共消息。每次启动时默认关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼會在附近裝置間轉送公開訊息。每次啟動時預設關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中継は近くの端末の間で公開メッセージを転送します。起動時の初期設定はオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중계는 근처 기기 사이에서 공개 메시지를 전달합니다. 시작할 때마다 꺼져 있습니다."
          }
        }
      }
    },

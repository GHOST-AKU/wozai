            "value": "關於"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリについて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        }
      }
    },
    "Accept and remember": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept and remember"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意并记住"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受並記住"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可して記憶"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하고 기억"
          }
        }
      }
    },
    "Accept once": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅本次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅允許這次"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回のみ許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번만 허용"
          }
        }
      }
    },
    "Accept this connection only if you recognize the device. A name is not proof of identity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept this connection only if you recognize the device. A name is not proof of identity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请仅在认识这台设备时接受连接。设备名称不能证明身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在認識這部裝置時接受連線，名稱並非身分證明。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知っているデバイスの場合のみ接続を許可してください。名前は身元の証明にはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알고 있는 기기일 때만 연결을 허용하세요. 이름만으로 신원을 확인할 수 없습니다."
          }
        }
      }
    },
    "Allow NearbyIM to access the local network in System Settings, and check that devices can reach each other.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow NearbyIM to access the local network in System Settings, and check that devices can reach each other."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许我在访问本地网络，并确认设备可以相互访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定允許 NearbyIM 存取區域網路，並確認裝置可互相連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で NearbyIM のローカルネットワークへのアクセスを許可し、デバイス同士が接続できることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 NearbyIM의 로컬 네트워크 접근을 허용하고 기기끼리 연결할 수 있는지 확인하세요."
          }
        }
      }
    },
    "Allow this device?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this device?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许这台设备连接？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許這部裝置？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを許可しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 허용할까요?"
          }
        }
      }
    },
